        {
          "name": "09 Erro - estoque insuficiente (estorna o item 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrlVendas}}/api/vendas",
