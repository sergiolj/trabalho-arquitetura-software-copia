    {
      "name": "ms-vendas",
      "item": [
        {
          "name": "01 Consultar estoque do produto 1 (antes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlEstoque}}/estoque/produto/1",
              "host": [
                "{{baseUrlEstoque}}"
              ],
              "path": [
                "estoque",
                "produto",
                "1"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estoque encontrado\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"saldoAntes\", pm.response.json().quantidade);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Registrar venda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrlVendas}}/api/vendas",
              "host": [
                "{{baseUrlVendas}}"
              ],
              "path": [
                "api",
                "vendas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"clienteId\": 1,\n    \"itens\": [\n        {\n            \"produtoId\": 1,\n            \"quantidade\": 2\n        },\n        {\n            \"produtoId\": 2,\n            \"quantidade\": 3\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Orquestração: GET ms-clientes, GET ms-produtos (um por item), POST ms-estoque/saidas (um por item) e gravação da venda."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Venda criada (201)\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cabeçalho Location presente\", () => pm.response.to.have.header(\"Location\"));",
                  "const venda = pm.response.json();",
                  "pm.test(\"Dados copiados de ms-clientes e ms-produtos\", () => {",
                  "    pm.expect(venda.clienteNome).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(venda.itens[0].precoUnitario).to.be.above(0);",
                  "    pm.expect(venda.status).to.eql(\"CONCLUIDA\");",
                  "});",
                  "pm.collectionVariables.set(\"vendaId\", venda.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar estoque do produto 1 (depois)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlEstoque}}/estoque/produto/1",
              "host": [
                "{{baseUrlEstoque}}"
              ],
              "path": [
                "estoque",
                "produto",
                "1"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const antes = Number(pm.collectionVariables.get(\"saldoAntes\"));",
                  "pm.test(\"Estoque baixou 2 unidades\", () => pm.expect(pm.response.json().quantidade).to.eql(antes - 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Buscar venda por ID",
