            "body": {
              "mode": "raw",
              "raw": "{\n    \"clienteId\": 2,\n    \"itens\": [\n        {\n            \"produtoId\": 1,\n            \"quantidade\": 1\n        },\n        {\n            \"produtoId\": 3,\n            \"quantidade\": 1000\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O item 1 é baixado e o item 2 falha. O ms-vendas devolve o item 1 ao estoque (compensação). Confira com a requisição 03: o saldo do produto 1 não muda."
          },
          "response": [],
